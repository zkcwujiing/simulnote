{
  "name": "simulnote",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SimulNote 同传笔记 —— 纯浏览器端零成本的英译中同声传译 + 自动纪要网站",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "lint:cost": "node scripts/check-zero-cost.mjs",
    "lint:size": "node scripts/check-upload-size.mjs",
    "verify": "pnpm build && pnpm lint:cost && node scripts/check-upload-size.mjs --warn-only"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@tanstack/react-virtual": "^3.13.12",
    "idb": "^8.0.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
